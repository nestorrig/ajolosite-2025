---
import App from "./r3f/App";


---
<div class="webgl">
  <App client:load />
</div>


<style>
  body,
  canvas {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  background-color: #121212;
  }

  .webgl {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>