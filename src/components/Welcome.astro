---
import WebGL from "./WebGL.astro";
import Hero from "./Hero.astro";
import Footer from "./Footer.astro";



---

<main>
	<WebGL />


	<section class="UI">
		<Hero />
	</section>

</main>

<style>

* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		font-family: "Lato", sans-serif;
	}
	
	.UI {
		pointer-events: none;
		color: #fff;
		position: fixed;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		padding: 16px;
	}
</style>