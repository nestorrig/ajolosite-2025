<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
		font-family: Arial, sans-serif;
	}
	span {
		position: fixed;
		top: 10px;
		right: 10px;
		display: block;
		margin-top: 1rem;
		font-size: 1.2rem;
		color: #333;
	}

	#root,
body,
canvas {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  margin: 0;
  background-color: #121212;
}

	.webgl {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	h1 {
		color: #333;
	}

	p {
		line-height: 1.6;
		color: #555;
	}

	a {
		color: #0070f3;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}
</style>